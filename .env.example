# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - EKOSISTEM AL-AFIYAH
# Yayasan Pendidikan Imam Bonjol Majalengka (TK IT, SD IT, & SMP IT Al-Afiyah)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MODE A: SQLite Lokal (Default untuk pengujian lokal instan / dev)
DATABASE_URL="file:./dev.db"

# MODE B: PostgreSQL Cloud / VPS Produksi (Aktifkan saat rilis produksi)
# Format Supabase: "postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
# Format Neon: "postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/alafiyah_db?sslmode=require"
# Format VPS Docker: "postgresql://alafiyah_admin:alafiyah_pass_2026@localhost:5432/alafiyah_prod?schema=public"
# DATABASE_URL="postgresql://postgres:rahasia123@localhost:5432/alafiyah_prod?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & AUTH
# ------------------------------------------------------------------------------
# Kunci enkripsi sesi JWT (Gunakan string acak 32+ karakter di produksi, misal: openssl rand -hex 32)
APP_SECRET="generate-a-strong-random-32-byte-hex-string-for-production"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-hex-string-for-production"

# URL Publik Aplikasi (Gunakan domain produksi yayasan)
# Lokal: "http://localhost:3000"
# Produksi: "https://alafiyah.sch.id"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY (QRIS & VIRTUAL ACCOUNT)
# ------------------------------------------------------------------------------
# Sandbox (Pengujian): Dimulai dengan 'SB-Mid-...'
# Production (Nyata): Dimulai dengan 'Mid-server-...' / 'Mid-client-...'
MIDTRANS_SERVER_KEY="SB-Mid-server-MOCK-AL-AFIYAH-TEST-KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-MOCK-AL-AFIYAH-TEST-KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-MOCK-AL-AFIYAH-TEST-KEY"
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. WHATSAPP NOTIFICATION GATEWAY (FONNTE / WABLAS / TWILIO)
# ------------------------------------------------------------------------------
# Token API WhatsApp Gateway untuk pengiriman notifikasi otomatis
WHATSAPP_GATEWAY_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="fonnte-api-token-yayasan-alafiyah-2026"
WHATSAPP_SENDER_NUMBER="6281234567890"

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOAD PATH CONFIGURATION
# ------------------------------------------------------------------------------
# Jalur penyimpanan berkas berkas PPDB fisik (default: folder public/uploads/ppdb)
UPLOAD_DIR="./public/uploads/ppdb"
MAX_FILE_SIZE_MB=5
